<!-- Share configuration related to this particular Share module extension, such as:
     - Doclib action config
     - Form config
     - Aspect and Type config
     - Advanced Search

    Note. Any configuration related to the whole Share.war webapp
           (i.e. not specific to this share extension) should be
            placed in the environment specific config file:
             alfresco/tomcat/shared/classes/alfresco/web-extension/share-config-custom.xml
     -->
<alfresco-config>
    <config evaluator="string-compare" condition="WebFramework">
        <web-framework>

            <defaults>
                <page-type>
                    <id>login</id>
                    <page-instance-id>redsis-login</page-instance-id>
                </page-type>
            </defaults>
        </web-framework>
    </config>

    <alfresco-config>
        <config evaluator="string-compare" condition="Share">
            <client>
                <dependencies>
                    <js src="/res/themes/standardTheme/yui/assets/favicon-loader.js" />
                </dependencies>
            </client>
        </config>
    </alfresco-config>
    <!--================================================================================================================
        Make custom types and aspects visible in "Change Type" and "Manage Aspects" actions.
         This will also make them visible when creating rules.
        (will be merged with out-of-the-box configured types and aspects)
    =============================================================================================================-->

    <config evaluator="string-compare" condition="DocumentLibrary">
        <aspects>
            <visible>
                <aspect name="acme:securityClassified"/>
            </visible>
            <addable> <!-- defaults to visible config -->
            </addable>
            <removeable> <!-- defaults to visible config -->
            </removeable>
        </aspects>
        <types>
            <!-- Define the ACME base doc type as decedent from cm:content -->
            <type name="cm:content">
                <subtype name="redsis:papelesdigitales" />
                <subtype name="redsis:factura" />
                <subtype name="redsis:soporte" />
                <subtype name="redsis:notaCredito" />
                <subtype name="redsis:notaDebito" />
            </type>
        </types>
    </config>

    <!-- ===================================================================== -->
    <!-- Formulario para el aspecto redsis:consecutivoCxP                      -->
    <!-- ===================================================================== -->
    <config evaluator="aspect" condition="redsis:consecutivoCxP">
        <forms>
            <form>
                <field-visibility>
                    <show id="redsis:incrementFacturaID" />
                    <show id="redsis:incrementNotaCreditoID" />
                    <show id="redsis:incrementNotaDebitoID" />
                    <show id="redsis:incrementSoporteID" />
                </field-visibility>
                <appearance>
                    <set id="redsis_consecutivoCxP_set0"
                         appearance="whitespace"
                         template="/org/alfresco/components/form/3-column-set.ftl"
                         label-id="form.set.redsis_consecutivoCxP" />

                    <field id="redsis:incrementFacturaID" set="redsis_consecutivoCxP_set0" />
                    <field id="redsis:incrementNotaCreditoID" set="redsis_consecutivoCxP_set0" />
                    <field id="redsis:incrementNotaDebitoID" set="redsis_consecutivoCxP_set0" />
                    <field id="redsis:incrementSoporteID" set="redsis_consecutivoCxP_set0" />
                </appearance>
            </form>
        </forms>
    </config>


    <!--================================================================================================================
          Advanced Search Forms for types
          (search forms for aspects are not available)
      =============================================================================================================-->

    <config evaluator="string-compare" condition="AdvancedSearch" replace="true">
        <advanced-search>
            <forms>
                <!-- Conserva cm:content para búsquedas generales -->
                <form labelId="search.form.label.cm_content"
                      descriptionId="search.form.desc.cm_content">cm:content</form>

                <!-- Formularios de búsqueda para tipos CxP -->
